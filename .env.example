# Copy to .env and adjust for local overrides if not using docker-compose defaults.

DATABASE_URL=jdbc:postgresql://localhost:5432/apilens
DATABASE_USERNAME=apilens
DATABASE_PASSWORD=apilens

APILENS_HTTPS_ONLY=true
MAX_RESPONSE_SIZE=2097152
MAX_REDIRECTS=3
APILENS_CONNECT_TIMEOUT_MS=3000
APILENS_READ_TIMEOUT_MS=5000

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Added once authentication is implemented (see docs/architecture.md).
# JWT_SECRET=
